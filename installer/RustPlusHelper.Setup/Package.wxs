<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="RustPlusHelper"
           Manufacturer="RustPlusHelper (unofficial community project)"
           Version="$(var.ProductVersion)"
           UpgradeCode="e0208e82-6ca3-4c34-a8b2-ffd3a4ab18c2"
           Scope="perMachine">

    <SummaryInformation Description="RustPlusHelper -- unofficial Rust+ companion dashboard" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of RustPlusHelper is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!--
      Per-machine (the WiX default) rather than per-user: a per-user MSI requires every single
      harvested file component to carry an HKCU registry keypath instead of a file keypath (ICE38),
      which the simple <Files> harvesting shorthand below does not generate. Per-machine needs an
      admin-elevation prompt during setup, which is normal/expected for a desktop installer.
    -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RustPlusHelper" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="RustPlusHelper" />
    </StandardDirectory>

    <Feature Id="Main" Title="RustPlusHelper" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)**" />
    </ComponentGroup>

    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="ApplicationStartMenuShortcut"
                Name="RustPlusHelper"
                Target="[INSTALLFOLDER]RustPlusHelper.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <!--
        HKCU (not HKLM) is the correct keypath here even though this is a per-machine package: a
        non-advertised Start Menu shortcut is inherently per-user data to Windows Installer's
        validation (ICE38/ICE43/ICE57 all reject an HKLM keypath on this exact component shape).
      -->
      <RegistryValue Root="HKCU"
                      Key="Software\RustPlusHelper"
                      Name="installed"
                      Type="integer"
                      Value="1"
                      KeyPath="yes" />
    </Component>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

  </Package>
</Wix>
