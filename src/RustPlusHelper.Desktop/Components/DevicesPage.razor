@implements IDisposable
@inject RustPlusHelper.Application.RustPlus.ISavedCameraRepository CameraRepository
@inject RustPlusHelper.Application.RustPlus.IPairedEntityRepository PairedEntityRepository
@inject RustPlusHelper.Application.RustPlus.RustPlusLiveSessionManager LiveSession
@inject RustPlusHelper.Application.Pairing.RustPlusEntityPairingManager EntityPairing
@using RustPlusHelper.Application.RustPlus
@using RustPlusHelper.Application.Pairing
@using RustPlusHelper.Application.Vending

<section class="content-page">
    <div class="page-heading">
        <div>
            <span class="eyebrow">VERIFIED ENTITY BOUNDARY</span>
            <h1>Devices</h1>
            <p>Rust+ has no device discovery; pair a Smart Switch, Smart Alarm, or Storage Monitor from Rust to add it here.</p>
        </div>
    </div>

    @if (ServerId is null)
    {
        <article class="surface-card empty-inline-state">Select a saved server to manage its devices.</article>
    }
    else
    {
        <div class="device-pairing-status surface-card">
            <div>
                <strong>@EntityPairing.State.Label</strong>
                @if (!string.IsNullOrWhiteSpace(EntityPairing.State.Detail))
                {
                    <p>@EntityPairing.State.Detail</p>
                }
            </div>
            <button type="button"
                    class="primary-button"
                    data-testid="listen-for-device-pairing"
                    disabled="@(!EntityPairing.IsConfigured || EntityPairing.State.Status == EntityPairingStatus.Listening)"
                    @onclick="ListenForDevicePairing">
                @(EntityPairing.State.Status == EntityPairingStatus.Listening ? "Listening…" : "Listen for device pairing")
            </button>
        </div>

        @if (PairedEntities.Count == 0)
        {
            <article class="surface-card empty-inline-state">No paired devices yet.</article>
        }
        else
        {
            <div class="camera-list">
                @foreach (var entity in PairedEntities)
                {
                    var live = LiveSession.PairedEntityStates.GetValueOrDefault(entity.EntityId);
                    <article class="surface-card camera-row" @key="entity.Id">
                        <div>
                            <strong>@entity.Nickname</strong>
                            <span class="camera-code">@DeviceKindLabel(entity.Kind)</span>
                            @if (live?.Error is { } error)
                            {
                                <p class="camera-status camera-error">@error</p>
                            }
                            else if (entity.Kind == PairedEntityKind.StorageMonitor)
                            {
                                @if (live is not null)
                                {
                                    <p class="camera-status">
                                        @(live.Capacity is { } capacity
                                            ? $"{live.Items.Count} item(s) · capacity {capacity}"
                                            : $"{live.Items.Count} item(s)")
                                    </p>
                                    @if (live.Items.Count > 0)
                                    {
                                        <ul class="storage-items">
                                            @foreach (var item in live.Items)
                                            {
                                                <li>@ItemLabel(item.ItemId) × @item.Quantity</li>
                                            }
                                        </ul>
                                    }
                                }
                                else
                                {
                                    <p class="camera-status">Reading…</p>
                                }
                            }
                            else
                            {
                                <p class="camera-status">@(live?.Value is { } value ? (value ? "On" : "Off") : "Reading…")</p>
                            }
                        </div>
                        <div class="camera-row-actions">
                            @if (entity.Kind == PairedEntityKind.Switch)
                            {
                                <button type="button"
                                        class="ghost-button"
                                        data-testid="toggle-switch"
                                        @onclick="() => LiveSession.ToggleSmartSwitchAsync(entity.EntityId)">
                                    Toggle
                                </button>
                                <button type="button"
                                        class="ghost-button"
                                        data-testid="strobe-switch"
                                        @onclick="() => LiveSession.StrobeSmartSwitchAsync(entity.EntityId, StrobeDuration, true)">
                                    Strobe
                                </button>
                            }
                            <button type="button" class="ghost-button" @onclick="() => RemoveEntity(entity.Id)">Remove</button>
                        </div>
                    </article>
                }
            </div>
        }
    }

    <div class="page-heading camera-heading">
        <div>
            <span class="eyebrow">USER-ENTERED CAMERA CODES</span>
            <h1>Cameras</h1>
            <p>Rust+ has no camera discovery; enter the in-game code shown on the camera's computer station.</p>
        </div>
    </div>

    @if (ServerId is null)
    {
        <article class="surface-card empty-inline-state">Select a saved server to manage its cameras.</article>
    }
    else
    {
        <form class="camera-add-form" @onsubmit="AddCamera">
            <label>
                <span>CAMERA CODE</span>
                <input data-testid="camera-code-input" placeholder="e.g. CAM01" @bind="_newCode" @bind:event="oninput" />
            </label>
            <label>
                <span>NICKNAME</span>
                <input data-testid="camera-nickname-input" placeholder="Front gate" @bind="_newNickname" @bind:event="oninput" />
            </label>
            <button data-testid="add-camera" type="submit" class="primary-button" disabled="@(!CanAddCamera)">Add camera</button>
        </form>

        @if (Cameras.Count == 0)
        {
            <article class="surface-card empty-inline-state">No saved cameras yet.</article>
        }
        else
        {
            <div class="camera-list">
                @foreach (var camera in Cameras)
                {
                    <article class="surface-card camera-row" @key="camera.Id">
                        <div>
                            <strong>@camera.Nickname</strong>
                            <span class="camera-code">@camera.Code</span>
                        </div>
                        <div class="camera-row-actions">
                            <button type="button"
                                    class="ghost-button"
                                    data-testid="view-camera"
                                    disabled="@(LiveSession.CurrentCamera.Status == CameraSessionStatus.Subscribing)"
                                    @onclick="() => ViewCamera(camera.Code)">
                                View
                            </button>
                            <button type="button" class="ghost-button" @onclick="() => RemoveCamera(camera.Id)">Remove</button>
                        </div>
                    </article>
                }
            </div>
        }

        @if (LiveSession.CurrentCamera.Status != CameraSessionStatus.Inactive)
        {
            <article class="surface-card camera-viewer">
                <header>
                    <div><span class="eyebrow">VIEWING</span><h2>@LiveSession.CurrentCamera.CameraCode</h2></div>
                    <button type="button" class="ghost-button" data-testid="stop-viewing-camera" @onclick="StopViewing">Stop viewing</button>
                </header>

                @if (LiveSession.CurrentCamera.Status == CameraSessionStatus.Subscribing)
                {
                    <p class="camera-status">Connecting to camera…</p>
                }
                else if (LiveSession.CurrentCamera.Status == CameraSessionStatus.Failed)
                {
                    <p class="camera-status camera-error">@(LiveSession.CurrentCamera.Error ?? "Camera subscription failed.")</p>
                }
                else if (LiveSession.CurrentCamera is { Status: CameraSessionStatus.Active, Info: { } info })
                {
                    @if (LiveSession.CurrentCamera.LatestFrame is { } frame)
                    {
                        <img class="camera-frame @(_isDraggingLook ? "dragging" : null)"
                             alt="Live camera view"
                             data-testid="camera-frame"
                             tabindex="0"
                             src="@($"data:image/png;base64,{Convert.ToBase64String(frame.PngImage)}")"
                             @onpointerdown="OnCameraPointerDown"
                             @onpointermove="OnCameraPointerMoveAsync"
                             @onpointerup="OnCameraPointerUp"
                             @onpointerleave="OnCameraPointerUp"
                             @onpointercancel="OnCameraPointerUp"
                             @onkeydown="OnCameraKeyDownAsync"
                             @onkeyup="OnCameraKeyUp" />
                        @if (!info.IsStaticCamera || info.IsDrone)
                        {
                            <p class="camera-hint">
                                @(!info.IsStaticCamera ? "Drag the image to look around." : null)
                                @(info.IsDrone ? "Hold W/A/S/D to fly, E to ascend, Q to descend." : null)
                            </p>
                        }
                    }
                    else
                    {
                        <p class="camera-status">Waiting for the first frame…</p>
                    }

                    <div class="camera-controls">
                        @if (info.IsPtzCamera)
                        {
                            <button type="button" class="ghost-button" data-testid="camera-zoom" @onclick="() => LiveSession.ZoomCameraAsync()">Zoom</button>
                        }
                        @if (info.IsAutoTurret)
                        {
                            <button type="button" class="ghost-button" data-testid="camera-shoot" @onclick="() => LiveSession.ShootCameraAsync()">Shoot</button>
                            <button type="button" class="ghost-button" data-testid="camera-reload" @onclick="() => LiveSession.ReloadCameraAsync()">Reload</button>
                        }
                        @if (!info.IsStaticCamera)
                        {
                            <button type="button" class="ghost-button" @onclick="() => LiveSession.LookCameraAsync(-LookStep, 0)">Look left</button>
                            <button type="button" class="ghost-button" @onclick="() => LiveSession.LookCameraAsync(LookStep, 0)">Look right</button>
                            <button type="button" class="ghost-button" @onclick="() => LiveSession.LookCameraAsync(0, -LookStep)">Look up</button>
                            <button type="button" class="ghost-button" @onclick="() => LiveSession.LookCameraAsync(0, LookStep)">Look down</button>
                        }
                        @if (info.IsDrone)
                        {
                            <button type="button" class="ghost-button" @onclick="() => LiveSession.MoveCameraAsync(CameraMoveDirection.Forward)">Forward</button>
                            <button type="button" class="ghost-button" @onclick="() => LiveSession.MoveCameraAsync(CameraMoveDirection.Backward)">Backward</button>
                            <button type="button" class="ghost-button" @onclick="() => LiveSession.MoveCameraAsync(CameraMoveDirection.Left)">Left</button>
                            <button type="button" class="ghost-button" @onclick="() => LiveSession.MoveCameraAsync(CameraMoveDirection.Right)">Right</button>
                            <button type="button" class="ghost-button" @onclick="() => LiveSession.MoveCameraAsync(CameraMoveDirection.Ascend)">Ascend</button>
                            <button type="button" class="ghost-button" @onclick="() => LiveSession.MoveCameraAsync(CameraMoveDirection.Descend)">Descend</button>
                        }
                    </div>
                }
            </article>
        }
    }
</section>

@code {
    private const float LookStep = 10f;
    private static readonly TimeSpan StrobeDuration = TimeSpan.FromSeconds(3);

    // Coalesces high-frequency pointermove deltas into one LookCameraAsync call per interval instead
    // of one per pixel of mouse movement — the same "accumulate but throttle publish" idea already
    // used for camera frames (see RustPlusLiveSessionManager's CameraFrameThrottle), applied here to
    // an outgoing command instead of an incoming one.
    private static readonly TimeSpan LookSendInterval = TimeSpan.FromMilliseconds(120);

    // A held W/A/S/D/E/Q key re-sends the discrete move command on a timer for as long as the key
    // stays down. Only one direction at a time is supported — no diagonal combination — since the
    // app-layer CameraMoveDirection is a single discrete value, not a combinable bitmask.
    private static readonly TimeSpan MoveRepeatInterval = TimeSpan.FromMilliseconds(400);

    private string _newCode = string.Empty;
    private string _newNickname = string.Empty;

    private bool _isDraggingLook;
    private bool _suppressNextRender;
    private double _lastPointerX;
    private double _lastPointerY;
    private double _pendingLookDeltaX;
    private double _pendingLookDeltaY;
    private DateTimeOffset _lastLookSentUtc = DateTimeOffset.MinValue;

    private CameraMoveDirection? _heldMoveDirection;
    private CancellationTokenSource? _moveRepeatCancellation;

    [Parameter, EditorRequired]
    public MapDashboardState State { get; set; } = MapDashboardState.NotStarted;

    private Guid? ServerId => State.ServerId;

    private bool CanAddCamera => !string.IsNullOrWhiteSpace(_newCode) && !string.IsNullOrWhiteSpace(_newNickname);

    private IReadOnlyList<SavedCamera> Cameras => ServerId is { } serverId ? CameraRepository.GetAll(serverId) : [];

    private IReadOnlyList<PairedEntity> PairedEntities =>
        ServerId is { } serverId ? PairedEntityRepository.GetAll(serverId) : [];

    protected override void OnInitialized()
    {
        LiveSession.StateChanged += HandleStateChanged;
        EntityPairing.StateChanged += HandleStateChanged;
    }

    // Pointermove fires on every pixel of mouse movement during a drag; nothing rendered here depends
    // on the drag position itself (only the "dragging" CSS class, toggled on pointerdown/up, which
    // this does not suppress), so skipping the render entirely avoids re-rendering the whole page at
    // mouse-move frequency — the same freeze class already fixed for map layer toggles (see AGENTS.md).
    protected override bool ShouldRender()
    {
        if (_suppressNextRender)
        {
            _suppressNextRender = false;
            return false;
        }

        return true;
    }

    public void Dispose()
    {
        LiveSession.StateChanged -= HandleStateChanged;
        EntityPairing.StateChanged -= HandleStateChanged;
        StopHeldMove();
    }

    private void OnCameraPointerDown(PointerEventArgs args)
    {
        if (LiveSession.CurrentCamera.Info is not { IsStaticCamera: false })
        {
            return;
        }

        _isDraggingLook = true;
        _lastPointerX = args.ClientX;
        _lastPointerY = args.ClientY;
        _pendingLookDeltaX = 0;
        _pendingLookDeltaY = 0;
    }

    private async Task OnCameraPointerMoveAsync(PointerEventArgs args)
    {
        if (!_isDraggingLook)
        {
            return;
        }

        _suppressNextRender = true;
        _pendingLookDeltaX += args.ClientX - _lastPointerX;
        _pendingLookDeltaY += args.ClientY - _lastPointerY;
        _lastPointerX = args.ClientX;
        _lastPointerY = args.ClientY;

        var now = DateTimeOffset.UtcNow;
        if (now - _lastLookSentUtc < LookSendInterval)
        {
            return;
        }

        var deltaX = (float)_pendingLookDeltaX;
        var deltaY = (float)_pendingLookDeltaY;
        _pendingLookDeltaX = 0;
        _pendingLookDeltaY = 0;
        _lastLookSentUtc = now;
        if (deltaX != 0 || deltaY != 0)
        {
            await LiveSession.LookCameraAsync(deltaX, deltaY);
        }
    }

    private void OnCameraPointerUp(PointerEventArgs args)
    {
        _isDraggingLook = false;
        _pendingLookDeltaX = 0;
        _pendingLookDeltaY = 0;
    }

    private Task OnCameraKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Repeat || LiveSession.CurrentCamera.Info is not { IsDrone: true })
        {
            return Task.CompletedTask;
        }

        var direction = ToMoveDirection(args.Key);
        if (direction is null || direction == _heldMoveDirection)
        {
            return Task.CompletedTask;
        }

        StartHeldMove(direction.Value);
        return Task.CompletedTask;
    }

    private void OnCameraKeyUp(KeyboardEventArgs args)
    {
        var direction = ToMoveDirection(args.Key);
        if (direction is not null && direction == _heldMoveDirection)
        {
            StopHeldMove();
        }
    }

    private static CameraMoveDirection? ToMoveDirection(string key) => key switch
    {
        "w" or "W" or "ArrowUp" => CameraMoveDirection.Forward,
        "s" or "S" or "ArrowDown" => CameraMoveDirection.Backward,
        "a" or "A" or "ArrowLeft" => CameraMoveDirection.Left,
        "d" or "D" or "ArrowRight" => CameraMoveDirection.Right,
        "e" or "E" => CameraMoveDirection.Ascend,
        "q" or "Q" => CameraMoveDirection.Descend,
        _ => null
    };

    private void StartHeldMove(CameraMoveDirection direction)
    {
        StopHeldMove();
        _heldMoveDirection = direction;
        var cancellation = new CancellationTokenSource();
        _moveRepeatCancellation = cancellation;
        _ = RepeatMoveWhileHeldAsync(direction, cancellation.Token);
    }

    private void StopHeldMove()
    {
        _heldMoveDirection = null;
        _moveRepeatCancellation?.Cancel();
        _moveRepeatCancellation?.Dispose();
        _moveRepeatCancellation = null;
    }

    private async Task RepeatMoveWhileHeldAsync(CameraMoveDirection direction, CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await LiveSession.MoveCameraAsync(direction, cancellationToken);
                await Task.Delay(MoveRepeatInterval, cancellationToken);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when the key is released or the component is disposed.
        }
    }

    private Task ListenForDevicePairing() => ServerId is { } serverId ? EntityPairing.ListenAsync(serverId) : Task.CompletedTask;

    private void RemoveEntity(Guid id)
    {
        if (ServerId is { } serverId)
        {
            PairedEntityRepository.Remove(serverId, id);
        }
    }

    private static string DeviceKindLabel(PairedEntityKind kind) => kind switch
    {
        PairedEntityKind.Switch => "SMART SWITCH",
        PairedEntityKind.Alarm => "SMART ALARM",
        PairedEntityKind.StorageMonitor => "STORAGE MONITOR",
        _ => "DEVICE"
    };

    private static string ItemLabel(int itemId) => ItemCatalog.TryResolve(itemId)?.Name ?? $"Item #{itemId}";

    private void AddCamera()
    {
        if (ServerId is not { } serverId || !CanAddCamera)
        {
            return;
        }

        CameraRepository.Add(new SavedCamera(Guid.NewGuid(), serverId, _newCode.Trim(), _newNickname.Trim(), DateTimeOffset.UtcNow));
        _newCode = string.Empty;
        _newNickname = string.Empty;
    }

    private void RemoveCamera(Guid id)
    {
        if (ServerId is { } serverId)
        {
            CameraRepository.Remove(serverId, id);
        }
    }

    private Task ViewCamera(string code) => LiveSession.ViewCameraAsync(code);

    private Task StopViewing()
    {
        StopHeldMove();
        _isDraggingLook = false;
        return LiveSession.StopViewingCameraAsync();
    }

    private void HandleStateChanged(object? sender, EventArgs args) => InvokeAsync(StateHasChanged);
}
