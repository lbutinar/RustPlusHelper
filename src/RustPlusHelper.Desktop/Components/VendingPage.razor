<section class="content-page">
    <div class="page-heading">
        <div>
            <span class="eyebrow">DIRECT MAP MARKERS</span>
            <h1>Vending</h1>
            <p>Phase 1 exposes numeric Rust item IDs honestly; item names require a versioned catalogue.</p>
        </div>
        <div class="summary-chip">@VendingMarkers.Count MACHINES</div>
    </div>

    <div class="card-grid">
        @foreach (var marker in VendingMarkers)
        {
            <article class="surface-card vending-card">
                <header>
                    <div><span class="eyebrow">VENDING MARKER</span><h2>@(marker.Name ?? "Unnamed machine")</h2></div>
                    <span class="status-pill @(marker.IsOutOfStock == true ? "offline" : "online")">
                        @(marker.IsOutOfStock == true ? "OUT" : "IN STOCK")
                    </span>
                </header>
                <div class="coordinates">X @marker.X?.ToString("0") · Y @marker.Y?.ToString("0")</div>
                @foreach (var order in marker.VendingOrders ?? [])
                {
                    <div class="vending-order">
                        <div><span>ITEM ID</span><strong>@order.ItemId × @order.Quantity</strong></div>
                        <div><span>PRICE</span><strong>@order.Cost × @order.CurrencyId</strong></div>
                        <div><span>STOCK</span><strong>@order.Stock</strong></div>
                    </div>
                }
            </article>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public MapDashboardState State { get; set; } = MapDashboardState.NotStarted;

    private IReadOnlyList<MapMarkerSnapshot> VendingMarkers => State.Markers?.Markers
        .Where(marker => marker.Kind == MapMarkerKind.VendingMachine)
        .ToArray() ?? [];
}
