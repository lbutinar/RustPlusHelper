@implements IDisposable
@inject PlayerIdentityManager Identity
@inject ServerManager Servers
@inject RustPlusConnectionManager Connections
@inject RustPlusPairingManager Pairing
@inject RustPlusHelper.Application.Map.IMapCacheRepository MapCache
@inject RustPlusHelper.Application.RustPlus.ICompanionEventRepository EventHistory
@inject TimeProvider Clock
@inject ILogger<ServersPage> Logger

<section class="content-page servers-page">
    <div class="page-heading">
        <div>
            <span class="eyebrow">LOCAL SERVER REGISTRY</span>
            <h1>Servers</h1>
            <p>Save Rust+ connection and manual pairing details securely on this PC.</p>
        </div>
        <span class="status-pill persistence-ready">SQLITE READY</span>
    </div>

    <div class="server-layout">
        <div class="server-list-column">
            <article class="surface-card server-card demo-server-card">
                <div class="server-monogram">EU</div>
                <div>
                    <span class="eyebrow">CURRENT MAP VIEW</span>
                    <h2>@(State.Server?.Name ?? "Fake EU Main")</h2>
                    <p>@State.Server?.MapName · @State.Server?.MapSize m</p>
                </div>
                <div class="server-stats">
                    <strong>@State.Server?.PlayerCount / @State.Server?.MaxPlayerCount</strong>
                    <span>PLAYERS</span>
                </div>
                <span class="status-pill online">@CurrentSourceLabel</span>
            </article>

            <div class="section-label-row">
                <div>
                    <span class="eyebrow">SAVED CONNECTION PROFILES</span>
                    <h2>@Servers.Profiles.Count server@(Servers.Profiles.Count == 1 ? null : "s")</h2>
                </div>
            </div>

            @if (Servers.Profiles.Count == 0)
            {
                <article class="surface-card empty-server-state">
                    <span class="empty-icon">+</span>
                    <h2>No saved servers</h2>
                    <p>Add the connection and pairing values for your Rust+ server.</p>
                </article>
            }
            else
            {
                <div class="saved-server-list">
                    @foreach (var profile in Servers.Profiles)
                    {
                        var hasPairing = Servers.HasPairing(profile.Id) && Identity.Current is not null;
                        var connection = Connections.GetState(profile.Id);
                        <article class="surface-card saved-server-card" @key="profile.Id">
                            <div class="server-monogram">@Monogram(profile.DisplayName)</div>
                            <div class="saved-server-main">
                                <div class="server-title-line">
                                    <h2>@profile.DisplayName</h2>
                                    @if (profile.Id == Servers.SelectedServerId)
                                    {
                                        <span class="status-pill selected">SELECTED</span>
                                    }
                                </div>
                                <p>@profile.Host:@profile.Port</p>
                                <span class="server-transport">
                                    @(profile.UseFacepunchProxy ? "Facepunch secure proxy" : "Explicit direct plaintext transport")
                                </span>
                                <div class="server-status-summary" data-testid="server-status-summary">
                                    @{
                                        var summary = StatusSummary(profile);
                                    }
                                    @if (summary is null)
                                    {
                                        <span class="muted-note">No cached data yet — open this server's map once to populate this.</span>
                                    }
                                    else
                                    {
                                        @if (summary.Population is not null)
                                        {
                                            <span>@summary.Population</span>
                                        }
                                        @if (summary.WipeSummary is not null)
                                        {
                                            <span>@summary.WipeSummary</span>
                                        }
                                        @if (summary.LastEventSummary is not null)
                                        {
                                            <span>@summary.LastEventSummary</span>
                                        }
                                    }
                                    <label class="wipe-cycle-picker">
                                        <span>Wipe cycle estimate</span>
                                        <select data-testid="server-wipe-cycle"
                                                value="@profile.WipeCycle"
                                                @onchange="@(e => SetWipeCycle(profile.Id, Enum.Parse<WipeCycle>((string)e.Value!)))">
                                            <option value="Unknown">Unknown</option>
                                            <option value="Weekly">Weekly</option>
                                            <option value="Biweekly">Biweekly</option>
                                            <option value="Monthly">Monthly</option>
                                        </select>
                                    </label>
                                </div>
                            </div>
                            <div class="server-actions">
                                <span class="status-pill @(hasPairing ? "paired" : "unpaired")">
                                    @(hasPairing ? "PAIRING SAVED" : "NOT PAIRED")
                                </span>
                                <button data-testid="test-server-connection"
                                        type="button"
                                        class="ghost-button test-connection-button"
                                        disabled="@connection.IsInProgress"
                                        @onclick="() => TestConnection(profile.Id)">
                                    @(connection.IsInProgress ? "Testing…" : "Test connection")
                                </button>
                                <button data-testid="open-server-map"
                                        type="button"
                                        class="primary-button"
                                        disabled="@(!hasPairing || connection.IsInProgress)"
                                        @onclick="() => OpenMap(profile.Id)">
                                    Open map
                                </button>
                                <button type="button" class="ghost-button" @onclick="() => SelectProfile(profile.Id)">Select</button>
                                <button type="button" class="ghost-button" @onclick="() => EditProfile(profile)">Edit</button>
                                @if (_removeConfirmationId == profile.Id)
                                {
                                    <button type="button" class="danger-button" @onclick="() => ConfirmRemove(profile.Id)">Confirm remove</button>
                                    <button type="button" class="ghost-button" @onclick="CancelRemove">Cancel</button>
                                }
                                else
                                {
                                    <button type="button" class="ghost-button danger-text" @onclick="() => BeginRemove(profile.Id)">Remove</button>
                                }
                            </div>
                            @if (connection.Status != RustPlusConnectionStatus.NotTested)
                            {
                                <div data-testid="connection-test-result"
                                     class="connection-test-result @ConnectionResultCss(connection.Status)"
                                     role="status">
                                    <span class="material-icons" aria-hidden="true">@ConnectionResultIcon(connection.Status)</span>
                                    <div>
                                        <strong>@connection.Label</strong>
                                        @if (!string.IsNullOrWhiteSpace(connection.Detail))
                                        {
                                            <p>@connection.Detail</p>
                                        }
                                        @if (connection.ServerInfo is { } serverInfo)
                                        {
                                            <small>
                                                @(serverInfo.Name ?? profile.DisplayName)
                                                @FormatPopulation(serverInfo)
                                            </small>
                                        }
                                    </div>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </div>

        <aside class="surface-card server-editor">
            <span class="eyebrow">@(_editingId is null ? "ADD PROFILE" : "EDIT PROFILE")</span>
            <h2>@(_editingId is null ? "Add a Rust+ server" : "Update saved server")</h2>
            <p>Pair automatically from Rust, or enter the server details manually below.</p>

            <div class="automatic-pairing-card">
                <div class="form-section-heading">
                    <span>AUTOMATIC RUST+ PAIRING</span>
                    <small>The app captures the server code, IP, port, Steam ID, and player token for you.</small>
                </div>
                <div class="pairing-status @PairingStatusCss" role="status">
                    <strong>@Pairing.State.Label</strong>
                    @if (!string.IsNullOrWhiteSpace(Pairing.State.Detail))
                    {
                        <span>@Pairing.State.Detail</span>
                    }
                </div>
                <div class="pairing-actions">
                    @if (!Pairing.IsConfigured
                        && Pairing.State.Status is not RustPlusPairingStatus.Registering)
                    {
                        <button data-testid="register-rustplus-pairing"
                                type="button"
                                class="primary-button"
                                @onclick="RegisterPairing">
                            Set up automatic pairing
                        </button>
                    }
                    @if (Pairing.IsConfigured
                        && Pairing.State.Status is not RustPlusPairingStatus.Registering
                        && Pairing.State.Status is not RustPlusPairingStatus.Listening)
                    {
                        <button data-testid="listen-rustplus-pairing"
                                type="button"
                                class="primary-button"
                                @onclick="ListenForPairing">
                            Listen for server pairing
                        </button>
                    }
                    @if (Pairing.State.Status is RustPlusPairingStatus.Registering or RustPlusPairingStatus.Listening)
                    {
                        <button data-testid="cancel-rustplus-pairing"
                                type="button"
                                class="ghost-button"
                                @onclick="Pairing.Cancel">
                            Cancel
                        </button>
                    }
                    @if (Pairing.State.Status != RustPlusPairingStatus.NotConfigured
                        && Pairing.State.Status is not RustPlusPairingStatus.Registering
                        && Pairing.State.Status is not RustPlusPairingStatus.Listening)
                    {
                        <button data-testid="reset-rustplus-pairing"
                                type="button"
                                class="ghost-button danger-text"
                                @onclick="Pairing.ResetCredentials">
                            Reset registration
                        </button>
                    }
                </div>
                <small class="pairing-help">Setup opens Chrome or Edge for Steam sign-in. Registration credentials are DPAPI-protected for this Windows user.</small>
            </div>

            <div class="identity-editor">
                <div class="form-section-heading">
                    <span>PLAYER IDENTITY · SAVED ONCE</span>
                    <small>This Steam64 ID is used for every server paired by this Windows user.</small>
                </div>
                <form class="identity-form" @onsubmit="SaveIdentity" @onsubmit:preventDefault>
                    <label>
                        <span>Steam64 ID</span>
                        <input data-testid="player-identity-id"
                               type="text"
                               inputmode="numeric"
                               maxlength="20"
                               autocomplete="off"
                               spellcheck="false"
                               @bind="_playerId"
                               placeholder="7656119…" />
                    </label>
                    <button data-testid="save-player-identity" type="submit" class="ghost-button">
                        @(Identity.Current is null ? "Save identity" : "Update identity")
                    </button>
                </form>
                @if (!string.IsNullOrWhiteSpace(_identityMessage))
                {
                    <div class="form-success" role="status">@_identityMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(_identityError))
                {
                    <div class="form-error" role="alert">@_identityError</div>
                }
            </div>

            <div class="form-section-heading server-details-heading">
                <span>SERVER CONNECTION</span>
                <small>Connection address and the token issued by this server pairing.</small>
            </div>

            <form @onsubmit="SaveProfile" @onsubmit:preventDefault>
                <label>
                    <span>Display name</span>
                    <input data-testid="server-name" maxlength="100" autocomplete="off" @bind="_displayName" placeholder="EU Main" />
                </label>
                <label>
                    <span>Companion host or IP</span>
                    <input data-testid="server-host" maxlength="255" autocomplete="off" @bind="_host" placeholder="companion.example.com" />
                </label>
                <label>
                    <span>Companion port</span>
                    <input data-testid="server-port" type="number" min="1" max="65535" @bind="_port" />
                </label>
                <div class="form-section-heading">
                    <span>SERVER PAIRING</span>
                    <small>The pairing notification supplies a different token for each Rust server.</small>
                </div>
                <label>
                    <span>Rust+ player token</span>
                    <input data-testid="server-player-token"
                           type="password"
                           inputmode="numeric"
                           maxlength="11"
                           autocomplete="new-password"
                           spellcheck="false"
                           @bind="_playerToken"
                           placeholder="Signed 32-bit token" />
                    <small class="field-help">
                        @(_editingId is null
                            ? "Required for a live connection. It will not be displayed again."
                            : "Leave blank to keep this server's saved token.")
                    </small>
                </label>
                <label class="proxy-choice">
                    <input data-testid="server-proxy" type="checkbox" @bind="_useFacepunchProxy" />
                    <span>
                        <strong>Use Facepunch secure proxy</strong>
                        <small>Recommended. Unchecking this explicitly enables plaintext direct transport.</small>
                    </span>
                </label>
                @if (!_useFacepunchProxy)
                {
                    <div class="transport-warning" role="alert">
                        <strong>Direct connection is not encrypted</strong>
                        <span>Your Steam64 ID and player token will be sent to the server over <code>ws://</code>. The app never falls back to this mode automatically.</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="form-error" role="alert">@_errorMessage</div>
                }

                <div class="editor-actions">
                    <button data-testid="save-server" type="submit" class="primary-button">
                        @(_editingId is null ? "Save server and pairing" : "Save changes")
                    </button>
                    @if (_editingId is not null)
                    {
                        <button type="button" class="ghost-button" @onclick="ResetEditor">Cancel edit</button>
                    }
                </div>
            </form>

            <div class="security-note">
                <strong>DPAPI protected</strong>
                <span>The token is masked, encrypted for the current Windows user, and never written to logs or stored as plaintext.</span>
            </div>
        </aside>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public MapDashboardState State { get; set; } = MapDashboardState.NotStarted;

    [Parameter]
    public EventCallback<Guid> OnOpenMap { get; set; }

    private string CurrentSourceLabel => State.DataSource switch
    {
        MapDashboardDataSource.Live => "LIVE RUST+",
        MapDashboardDataSource.Cache => "CACHED MAP",
        _ => "FAKE DATA"
    };

    private Guid? _editingId;
    private Guid? _removeConfirmationId;
    private string _displayName = string.Empty;
    private string _host = string.Empty;
    private int _port = 28082;
    private bool _useFacepunchProxy = true;
    private string _playerId = string.Empty;
    private string _playerToken = string.Empty;
    private string? _errorMessage;
    private string? _identityMessage;
    private string? _identityError;

    protected override void OnInitialized()
    {
        Identity.Changed += HandleIdentityChanged;
        Servers.Changed += HandleServersChanged;
        Connections.StateChanged += HandleConnectionStateChanged;
        Pairing.StateChanged += HandlePairingStateChanged;
        Identity.Load();
        Servers.Load();
        _playerId = Identity.Current?.SteamId.ToString(System.Globalization.CultureInfo.InvariantCulture)
            ?? string.Empty;
    }

    public void Dispose()
    {
        Identity.Changed -= HandleIdentityChanged;
        Servers.Changed -= HandleServersChanged;
        Connections.StateChanged -= HandleConnectionStateChanged;
        Pairing.StateChanged -= HandlePairingStateChanged;
    }

    private void SaveIdentity()
    {
        try
        {
            var playerId = ParsePlayerId()
                ?? throw new ArgumentException("Steam64 ID is required.");
            Identity.Save(playerId);
            _playerId = playerId.ToString(System.Globalization.CultureInfo.InvariantCulture);
            _identityMessage = "Steam64 identity saved for all servers.";
            _identityError = null;
            _errorMessage = null;
        }
        catch (ArgumentException exception)
        {
            _identityMessage = null;
            _identityError = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _identityMessage = null;
            _identityError = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to save the player identity.");
            _identityMessage = null;
            _identityError = "The player identity could not be saved.";
        }
    }

    private void SaveProfile()
    {
        try
        {
            var profile = Servers.SaveWithPairing(new ServerProfileDraft(
                _editingId,
                _displayName,
                _host,
                _port,
                _useFacepunchProxy,
                null),
                _playerToken.AsSpan());
            Connections.Reset(profile.Id);
            ResetEditor();
        }
        catch (ArgumentException exception)
        {
            _errorMessage = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to save a server profile.");
            _errorMessage = "The server profile could not be saved.";
        }
    }

    private void SelectProfile(Guid id)
    {
        if (!Servers.Select(id))
        {
            _errorMessage = "The selected server no longer exists.";
        }
    }

    private async Task TestConnection(Guid id)
    {
        _errorMessage = null;
        if (!Servers.Select(id))
        {
            _errorMessage = "The selected server no longer exists.";
            return;
        }

        try
        {
            await Connections.TestConnectionAsync(id);
        }
        catch (OperationCanceledException)
        {
            _errorMessage = "The connection test was cancelled.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unexpected failure while testing Rust+ server {ServerId}.", id);
            _errorMessage = "The connection test failed unexpectedly.";
        }
    }

    private Task OpenMap(Guid id) => OnOpenMap.InvokeAsync(id);

    private void EditProfile(ServerProfile profile)
    {
        _editingId = profile.Id;
        _displayName = profile.DisplayName;
        _host = profile.Host;
        _port = profile.Port;
        _useFacepunchProxy = profile.UseFacepunchProxy;
        _playerToken = string.Empty;
        _errorMessage = null;
    }

    private void BeginRemove(Guid id) => _removeConfirmationId = id;

    private void CancelRemove() => _removeConfirmationId = null;

    private void ConfirmRemove(Guid id)
    {
        try
        {
            Servers.Remove(id);
            Connections.Reset(id);
            _removeConfirmationId = null;
            if (_editingId == id)
            {
                ResetEditor();
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to remove a server profile.");
            _errorMessage = "The server profile could not be removed.";
        }
    }

    private void ResetEditor()
    {
        _editingId = null;
        _displayName = string.Empty;
        _host = string.Empty;
        _port = 28082;
        _useFacepunchProxy = true;
        _playerToken = string.Empty;
        _errorMessage = null;
    }

    private void HandleServersChanged(object? sender, EventArgs args) =>
        _ = InvokeAsync(StateHasChanged);

    private void HandleIdentityChanged(object? sender, EventArgs args) =>
        _ = InvokeAsync(StateHasChanged);

    private void HandleConnectionStateChanged(object? sender, EventArgs args) =>
        _ = InvokeAsync(StateHasChanged);

    private void HandlePairingStateChanged(object? sender, EventArgs args) =>
        _ = InvokeAsync(StateHasChanged);

    private async Task RegisterPairing() => await Pairing.RegisterAsync();

    private async Task ListenForPairing()
    {
        await Pairing.ListenAsync();
        if (Pairing.State.SavedServerId is { } serverId)
        {
            Connections.Reset(serverId);
            _playerId = Identity.Current?.SteamId.ToString(System.Globalization.CultureInfo.InvariantCulture)
                ?? string.Empty;
        }
    }

    private string PairingStatusCss => Pairing.State.Status switch
    {
        RustPlusPairingStatus.Paired or RustPlusPairingStatus.Ready => "pairing-ready",
        RustPlusPairingStatus.Registering or RustPlusPairingStatus.Listening => "pairing-active",
        RustPlusPairingStatus.Failed => "pairing-failed",
        _ => string.Empty
    };

    private static string ConnectionResultCss(RustPlusConnectionStatus status) => status switch
    {
        RustPlusConnectionStatus.Succeeded => "connection-success",
        RustPlusConnectionStatus.Connecting or RustPlusConnectionStatus.Authenticating => "connection-progress",
        _ => "connection-failure"
    };

    private static string ConnectionResultIcon(RustPlusConnectionStatus status) => status switch
    {
        RustPlusConnectionStatus.Succeeded => "check_circle",
        RustPlusConnectionStatus.Connecting or RustPlusConnectionStatus.Authenticating => "sync",
        RustPlusConnectionStatus.PairingRequired => "key",
        RustPlusConnectionStatus.AuthenticationRejected => "lock",
        _ => "error"
    };

    private static string FormatPopulation(ServerInfoSnapshot serverInfo) =>
        serverInfo.PlayerCount is { } players && serverInfo.MaxPlayerCount is { } maximum
            ? $" · {players} / {maximum} players"
            : string.Empty;

    private sealed record ServerStatusSummary(string? Population, string? WipeSummary, string? LastEventSummary);

    /// <summary>Built entirely from locally cached data — the last successful map fetch and event
    /// history for this server — so it works for every saved server, not only the one currently
    /// connected. It is therefore "as of last connection", never live, for any server other than the
    /// one actually open right now.</summary>
    private ServerStatusSummary? StatusSummary(ServerProfile profile)
    {
        var cached = MapCache.Get(profile.Id);
        if (cached is null)
        {
            return null;
        }

        var population = cached.Server.PlayerCount is { } players && cached.Server.MaxPlayerCount is { } maximum
            ? $"{players} / {maximum} players as of {FormatAge(cached.RetrievedAtUtc)}"
            : null;

        string? wipeSummary = null;
        if (cached.Server.WipeTimeUtc is { } wipeTimeUtc)
        {
            wipeSummary = $"Wiped {FormatAge(wipeTimeUtc)}";
            if (CycleLength(profile.WipeCycle) is { } cycleLength)
            {
                var remaining = wipeTimeUtc + cycleLength - Clock.GetUtcNow();
                wipeSummary += remaining > TimeSpan.Zero
                    ? $" · next wipe in ~{FormatDuration(remaining)} (your estimate)"
                    : " · your estimated next wipe has already passed";
            }
        }

        var lastEvent = EventHistory.GetRecent(profile.Id, 1).FirstOrDefault();
        var lastEventSummary = lastEvent is not null
            ? $"Last event: {lastEvent.Title} ({FormatAge(lastEvent.OccurredAtUtc)})"
            : null;

        return new ServerStatusSummary(population, wipeSummary, lastEventSummary);
    }

    private void SetWipeCycle(Guid serverId, WipeCycle cycle)
    {
        try
        {
            Servers.SetWipeCycle(serverId, cycle);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to update the wipe-cycle estimate for {ServerId}.", serverId);
            _errorMessage = "The wipe-cycle estimate could not be saved.";
        }
    }

    /// <summary>A user-entered guess, not a Rust+-reported schedule — see <see cref="WipeCycle"/>.</summary>
    private static TimeSpan? CycleLength(WipeCycle cycle) => cycle switch
    {
        WipeCycle.Weekly => TimeSpan.FromDays(7),
        WipeCycle.Biweekly => TimeSpan.FromDays(14),
        WipeCycle.Monthly => TimeSpan.FromDays(30),
        _ => null
    };

    private string FormatAge(DateTimeOffset pastUtc) => $"{FormatDuration(Clock.GetUtcNow() - pastUtc)} ago";

    private static string FormatDuration(TimeSpan span)
    {
        if (span < TimeSpan.Zero)
        {
            span = -span;
        }

        if (span.TotalDays >= 1)
        {
            return $"{(int)span.TotalDays}d";
        }

        return span.TotalHours >= 1
            ? $"{(int)span.TotalHours}h"
            : $"{Math.Max(1, (int)span.TotalMinutes)}m";
    }

    private static string Monogram(string name)
    {
        var words = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return string.Concat(words.Take(2).Select(word => char.ToUpperInvariant(word[0])));
    }

    private ulong? ParsePlayerId()
    {
        if (string.IsNullOrWhiteSpace(_playerId))
        {
            return null;
        }

        if (!ulong.TryParse(
                _playerId.Trim(),
                System.Globalization.NumberStyles.None,
                System.Globalization.CultureInfo.InvariantCulture,
                out var playerId)
            || playerId == 0)
        {
            throw new ArgumentException("Steam64 ID must be a positive unsigned integer.");
        }

        return playerId;
    }

}
