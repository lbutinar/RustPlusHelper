<section class="map-page">
    <div class="page-heading map-heading">
        <div>
            <span class="eyebrow">@SourceEyebrow</span>
            <h1>Server map</h1>
        </div>
        <div class="map-heading-actions">
          <div class="map-metrics">
            <div>
                <span>PLAYERS</span>
                <strong>@State.Server?.PlayerCount / @State.Server?.MaxPlayerCount</strong>
            </div>
            <div>
                <span>QUEUE</span>
                <strong>@State.Server?.QueuedPlayerCount</strong>
            </div>
            <div>
                <span>MAP SIZE</span>
                <strong>@State.Server?.MapSize m</strong>
            </div>
          </div>
          @if (State.ServerId is not null)
          {
              <button data-testid="import-map-topology"
                      type="button"
                      class="ghost-button"
                      disabled="@State.IsTopologyImporting"
                      @onclick="ImportTopology">
                  <span class="material-icons" aria-hidden="true">layers</span>
                  @(State.IsTopologyImporting ? "Finding Rust map…" : "Choose .map manually")
              </button>
              <button data-testid="refresh-live-data"
                      type="button"
                      class="ghost-button"
                      disabled="@State.IsLiveDataRefreshing"
                      @onclick="RefreshLiveData">
                  @(State.IsLiveDataRefreshing ? "Refreshing…" : "Refresh team + markers")
              </button>
              <button data-testid="refresh-live-map"
                      type="button"
                      class="primary-button"
                      disabled="@State.IsLiveDataRefreshing"
                      @onclick="RefreshMap">
                  Refresh everything
              </button>
          }
        </div>
    </div>

    <div class="map-workspace">
        <div class="map-stage">
            <MapCanvas State="State" FocusRequest="_effectiveFocusRequest" />

            <div class="map-toolbar" aria-label="Map tools">
                <button type="button" title="Fit the map" @onclick="FitMap">⌖</button>
                <button data-testid="toggle-grid"
                        type="button"
                        class="material-icons"
                        title="@(IsGridVisible ? "Hide map grid" : "Show map grid")"
                        @onclick="ToggleGrid">grid_on</button>
                <form class="grid-search" @onsubmit="SearchGrid" @onsubmit:preventDefault>
                    <input data-testid="grid-search-input"
                           placeholder="Grid e.g. H14"
                           maxlength="6"
                           autocomplete="off"
                           spellcheck="false"
                           @bind="_gridQuery"
                           @bind:event="oninput" />
                    <button type="submit" data-testid="grid-search-submit" title="Go to grid reference">
                        <span class="material-icons" aria-hidden="true">search</span>
                    </button>
                </form>
            </div>
            @if (_gridSearchError is not null)
            {
                <div class="grid-search-error" data-testid="grid-search-error" role="alert">@_gridSearchError</div>
            }

            <div class="map-legend">
                <span><i class="legend-dot team"></i>Team</span>
                <span><i class="legend-dot vending"></i>Vending</span>
                <span><i class="legend-dot event"></i>Events</span>
                <span><i class="legend-dot monument"></i>Monuments</span>
            </div>

            @if (IsAnyTerrainAnalysisVisible)
            {
                <div class="terrain-analysis-legends">
                    @if (IsLayerVisible(MapLayerKind.TerrainSlope))
                    {
                        <div class="terrain-analysis-legend" aria-label="Terrain slope colors">
                            <strong>Terrain slope</strong>
                            <span><i class="slope-flat"></i>Flat ≤ 5°</span>
                            <span><i class="slope-gentle"></i>Gentle ≤ 12°</span>
                            <span><i class="slope-moderate"></i>Moderate ≤ 25°</span>
                            <span><i class="slope-steep"></i>Steep &gt; 25°</span>
                            <span><i class="slope-water"></i>Water</span>
                        </div>
                    }
                    @if (IsLayerVisible(MapLayerKind.BuildPlanning))
                    {
                        <div class="terrain-analysis-legend" aria-label="Build planning colors">
                            <strong>Build planning · candidates only</strong>
                            <span><i class="plan-candidate"></i>Good candidate</span>
                            <span><i class="plan-gentle"></i>Sloped / caution</span>
                            <span><i class="plan-excluded"></i>Known blocked/steep</span>
                            <span><i class="plan-water"></i>Water</span>
                        </div>
                    }
                    @if (IsLayerVisible(MapLayerKind.Elevation))
                    {
                        <div class="terrain-analysis-legend" aria-label="Elevation colors">
                            <strong>Elevation · 25 m contours / bold 100 m</strong>
                            <span><i class="elevation-low"></i>≤ 25 m</span>
                            <span><i class="elevation-mid"></i>25–100 m</span>
                            <span><i class="elevation-high"></i>100–200 m</span>
                            <span><i class="elevation-summit"></i>&gt; 200 m</span>
                        </div>
                    }
                    @if (IsLayerVisible(MapLayerKind.WaterDepth))
                    {
                        <div class="terrain-analysis-legend" aria-label="Water depth colors">
                            <strong>Water depth + shoreline</strong>
                            <span><i class="water-shore"></i>Shore</span>
                            <span><i class="water-shallow"></i>≤ 5 m</span>
                            <span><i class="water-medium"></i>5–20 m</span>
                            <span><i class="water-deep"></i>&gt; 20 m</span>
                        </div>
                    }
                    @if (IsLayerVisible(MapLayerKind.ResourcePotential))
                    {
                        <div class="terrain-analysis-legend" aria-label="Resource potential colors">
                            <strong>Resource potential · topology only</strong>
                            <span><i class="resource-ore-high"></i>Ore potential (high)</span>
                            <span><i class="resource-ore-moderate"></i>Ore potential (moderate)</span>
                            <span><i class="resource-sulfur"></i>Sulfur potential</span>
                        </div>
                    }
                </div>
            }
        </div>

        <aside class="layer-panel">
            <div class="panel-heading">
                <div>
                    <span class="eyebrow">MAP CONTROL</span>
                    <h2>Layers</h2>
                </div>
                <span class="layer-count">@VisibleLayerCount ON</span>
            </div>

            <div class="layer-list">
                @foreach (var layer in State.Layers)
                {
                    <label class="layer-row @(!layer.IsAvailable ? "unavailable" : null)"
                           title="@layer.UnavailableReason">
                        <span class="layer-symbol @MapRenderModelFactory.ToLayerKey(layer.Kind)"></span>
                        <span class="layer-copy">
                            <strong>@layer.DisplayName</strong>
                            <small>@layer.SourceLabel</small>
                        </span>
                        <input type="checkbox"
                               checked="@layer.IsVisible"
                               disabled="@(!layer.IsAvailable)"
                               @onchange="args => ChangeLayer(layer, args)" />
                        <span class="switch-track"><span></span></span>
                    </label>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(State.TopologyStatus))
            {
                <div class="map-topology-status" role="status">
                    <span class="material-icons" aria-hidden="true">terrain</span>
                    <div>
                        <strong>@State.TopologyStatus</strong>
                        @if (State.Topology is { } topology)
                        {
                            <small>
                                @topology.Data.WorldSize m · @topology.Data.SourceLayers.Count source layers ·
                                @topology.Data.Paths.Count paths · @topology.Data.PrefabCount prefabs
                            </small>
                        }
                    </div>
                </div>
            }

            @if (State.ServerId is not null)
            {
                <div class="personal-pins-panel">
                    <div class="panel-heading">
                        <div>
                            <span class="eyebrow">MANUAL</span>
                            <h2>Personal pins</h2>
                        </div>
                    </div>
                    <form class="pin-add-form" @onsubmit="AddPin" @onsubmit:preventDefault>
                        <label>
                            <span>GRID</span>
                            <input data-testid="pin-grid-input"
                                   placeholder="e.g. H14"
                                   maxlength="6"
                                   autocomplete="off"
                                   spellcheck="false"
                                   @bind="_pinGridQuery"
                                   @bind:event="oninput" />
                        </label>
                        <label>
                            <span>NOTE</span>
                            <input data-testid="pin-note-input"
                                   placeholder="Loot stash"
                                   maxlength="200"
                                   @bind="_pinNote"
                                   @bind:event="oninput" />
                        </label>
                        <button type="submit" data-testid="add-pin" class="primary-button">Add pin</button>
                    </form>
                    @if (_pinError is not null)
                    {
                        <div class="pin-error" data-testid="pin-error" role="alert">@_pinError</div>
                    }
                    @if (State.PersonalPins is { Count: > 0 } pins)
                    {
                        <div class="pin-list">
                            @foreach (var pin in pins)
                            {
                                <div class="pin-row" @key="pin.Id">
                                    <span title="@pin.Note">@pin.Note</span>
                                    <button type="button"
                                            class="ghost-button"
                                            data-testid="remove-pin"
                                            @onclick="() => RemovePin(pin.Id)">
                                        Remove
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <div class="source-note">
                <strong>Truthful layers</strong>
                <p>Unavailable data stays disabled. Nothing on this map is inferred without a source label.</p>
            </div>
        </aside>
    </div>

    @if (!string.IsNullOrWhiteSpace(State.ErrorMessage))
    {
        <div class="map-cache-warning" role="status">@State.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(State.LiveDataError))
    {
        <div class="map-live-warning" role="status">@State.LiveDataError</div>
    }

    @if (!string.IsNullOrWhiteSpace(State.TopologyError))
    {
        <div class="map-topology-warning" role="alert">@State.TopologyError</div>
    }

    <div class="event-strip">
        <div class="event-title">
            <span class="live-pulse"></span>
            MAP SNAPSHOT
        </div>
        <div class="event-item">
            <time>NOW</time>
            <span class="event-source direct">SNAPSHOT</span>
            <strong>@(State.Team?.Members.Count ?? 0) team members · @(State.Markers?.Markers.Count ?? 0) markers</strong>
        </div>
        <div class="event-item">
            <time>NOW</time>
            <span class="event-source direct">SNAPSHOT</span>
            <strong>@LiveSnapshotAgeLabel</strong>
        </div>
        <div class="event-item muted">
            <time>LIVE</time>
            <span class="event-source derived">DERIVED</span>
            <strong>@State.Events.Count transport and snapshot-diff events retained in memory</strong>
        </div>
    </div>
</section>

@code {
    [Inject]
    private IJSRuntime JavaScript { get; set; } = null!;

    [Parameter, EditorRequired]
    public MapDashboardState State { get; set; } = MapDashboardState.NotStarted;

    [Parameter]
    public MapFocusRequest? FocusRequest { get; set; }

    [Parameter]
    public EventCallback<LayerVisibilityChange> OnLayerChanged { get; set; }

    [Parameter]
    public EventCallback OnRefreshRequested { get; set; }

    [Parameter]
    public EventCallback OnLiveDataRefreshRequested { get; set; }

    [Parameter]
    public EventCallback OnTopologyImportRequested { get; set; }

    [Parameter]
    public EventCallback<AddPersonalPinRequest> OnPersonalPinAdded { get; set; }

    [Parameter]
    public EventCallback<Guid> OnPersonalPinRemoved { get; set; }

    private MapFocusRequest? _lastExternalFocusRequest;
    private MapFocusRequest? _effectiveFocusRequest;
    private long _focusSequence;
    private string _gridQuery = string.Empty;
    private string? _gridSearchError;
    private string _pinGridQuery = string.Empty;
    private string _pinNote = string.Empty;
    private string? _pinError;

    protected override void OnParametersSet()
    {
        // FocusRequest (from Main.razor, e.g. "locate this vending machine") and the grid search box
        // below both want to drive the same MapCanvas focus target; re-stamping whichever changed with
        // a page-local sequence lets MapCanvas's single "did the sequence change" check keep working
        // regardless of which source produced the request.
        if (FocusRequest is not null && !ReferenceEquals(FocusRequest, _lastExternalFocusRequest))
        {
            _lastExternalFocusRequest = FocusRequest;
            _effectiveFocusRequest = FocusRequest with { Sequence = ++_focusSequence };
        }
    }

    private void SearchGrid()
    {
        _gridSearchError = null;
        var grid = MapRenderModelFactory.Create(State)?.Grid;
        if (grid is null)
        {
            _gridSearchError = "The map hasn't finished loading yet.";
            return;
        }

        if (!MapGrid.TryParseCellCenter(_gridQuery, grid, out var pixelX, out var pixelY))
        {
            _gridSearchError = $"\"{_gridQuery}\" isn't a valid grid reference for this map.";
            return;
        }

        _effectiveFocusRequest = new MapFocusRequest(
            $"pixel:{pixelX.ToString(System.Globalization.CultureInfo.InvariantCulture)},{pixelY.ToString(System.Globalization.CultureInfo.InvariantCulture)}",
            ++_focusSequence);
    }

    private async Task AddPin()
    {
        _pinError = null;
        if (State.Server?.MapSize is not { } mapSize)
        {
            _pinError = "The map hasn't finished loading yet.";
            return;
        }

        if (!MapGrid.TryParseCellWorldCenter(_pinGridQuery, mapSize, out var worldX, out var worldY))
        {
            _pinError = $"\"{_pinGridQuery}\" isn't a valid grid reference for this map.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_pinNote))
        {
            _pinError = "Enter a short note for this pin.";
            return;
        }

        await OnPersonalPinAdded.InvokeAsync(new AddPersonalPinRequest(worldX, worldY, _pinNote.Trim()));
        _pinGridQuery = string.Empty;
        _pinNote = string.Empty;
    }

    private Task RemovePin(Guid id) => OnPersonalPinRemoved.InvokeAsync(id);

    private int VisibleLayerCount => State.Layers.Count(layer => layer.IsVisible && layer.IsAvailable);

    private bool IsGridVisible => State.Layers.FirstOrDefault(layer => layer.Kind == MapLayerKind.Grid)
        is { IsVisible: true, IsAvailable: true };

    private bool IsAnyTerrainAnalysisVisible => IsLayerVisible(MapLayerKind.TerrainSlope)
        || IsLayerVisible(MapLayerKind.BuildPlanning)
        || IsLayerVisible(MapLayerKind.Elevation)
        || IsLayerVisible(MapLayerKind.WaterDepth)
        || IsLayerVisible(MapLayerKind.ResourcePotential);

    private bool IsLayerVisible(MapLayerKind kind) => State.Layers.FirstOrDefault(layer => layer.Kind == kind)
        is { IsVisible: true, IsAvailable: true };

    private string SourceEyebrow => State.DataSource switch
    {
        MapDashboardDataSource.Live => "LIVE RUST+ SNAPSHOT",
        MapDashboardDataSource.Cache => "CACHED RUST+ SNAPSHOT",
        _ => "DEVELOPMENT DATA"
    };

    private string SnapshotAgeLabel => State.MapRetrievedAtUtc is { } retrieved
        ? $"Map retrieved {retrieved.ToLocalTime():dd MMM · HH:mm}"
        : "Map retrieval time unavailable";

    private string LiveSnapshotAgeLabel => State.LiveDataRetrievedAtUtc is { } retrieved
        ? $"Live data refreshed {retrieved.ToLocalTime():HH:mm:ss}"
        : SnapshotAgeLabel;

    private async Task ChangeLayer(MapLayerState layer, ChangeEventArgs args)
    {
        var isVisible = args.Value is bool checkedValue
            ? checkedValue
            : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        await OnLayerChanged.InvokeAsync(new LayerVisibilityChange(layer.Kind, isVisible));
    }

    private Task FitMap() => JavaScript.InvokeVoidAsync("rustPlusMap.fitActive").AsTask();

    private Task ToggleGrid() => OnLayerChanged.InvokeAsync(
        new LayerVisibilityChange(MapLayerKind.Grid, !IsGridVisible));

    private Task RefreshMap() => OnRefreshRequested.InvokeAsync();

    private Task RefreshLiveData() => OnLiveDataRefreshRequested.InvokeAsync();

    private Task ImportTopology() => OnTopologyImportRequested.InvokeAsync();
}
