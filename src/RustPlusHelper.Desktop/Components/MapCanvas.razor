@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<div id="@ElementId" class="rust-map" aria-label="Interactive Rust server map">
    @if (State.ConnectionState != DashboardConnectionState.Ready)
    {
        <div class="map-placeholder">Waiting for map data…</div>
    }
</div>

@code {
    private readonly string _elementId = $"rust-map-{Guid.NewGuid():N}";
    private bool _interopCreated;
    private byte[]? _encodedImage;
    private string? _imageSource;
    private string? _renderedImageSource;
    private string? _renderedTopologyFingerprint;
    private ServerMapSnapshot? _renderedMap;
    private TeamSnapshot? _renderedTeam;
    private MapMarkersSnapshot? _renderedMarkers;
    private IReadOnlyList<CompanionEvent>? _renderedEvents;
    private SavedMapTopology? _renderedTopology;
    private IReadOnlyList<PersonalMapPin>? _renderedPersonalPins;
    private uint? _renderedMapSize;
    private IReadOnlyDictionary<string, bool>? _renderedLayerVisibility;
    private long _handledFocusSequence;

    [Parameter, EditorRequired]
    public MapDashboardState State { get; set; } = MapDashboardState.NotStarted;

    [Parameter]
    public MapFocusRequest? FocusRequest { get; set; }

    private string ElementId => _elementId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var layerVisibility = State.Layers.ToDictionary(
            layer => MapRenderModelFactory.ToLayerKey(layer.Kind),
            layer => layer.IsVisible && layer.IsAvailable,
            StringComparer.Ordinal);
        var requiresFullRender = !_interopCreated
            || !ReferenceEquals(_renderedMap, State.Map)
            || !ReferenceEquals(_renderedTeam, State.Team)
            || !ReferenceEquals(_renderedMarkers, State.Markers)
            || !ReferenceEquals(_renderedEvents, State.Events)
            || !ReferenceEquals(_renderedTopology, State.Topology)
            || !ReferenceEquals(_renderedPersonalPins, State.PersonalPins)
            || _renderedMapSize != State.Server?.MapSize;
        if (!requiresFullRender)
        {
            if (!LayerVisibilityEquals(_renderedLayerVisibility, layerVisibility))
            {
                await JavaScript.InvokeVoidAsync(
                    "rustPlusMap.setLayerVisibility",
                    ElementId,
                    layerVisibility);
                _renderedLayerVisibility = layerVisibility;
            }

            await FocusRequestedItemAsync();
            return;
        }

        var model = MapRenderModelFactory.Create(State);
        if (model is null)
        {
            return;
        }

        var imageSource = GetImageSource();
        var topologyFingerprint = State.Topology?.Data.Sha256;
        var includeExternalMapData = !_interopCreated
            || !ReferenceEquals(_renderedTopology, State.Topology)
            || !string.Equals(_renderedImageSource, imageSource, StringComparison.Ordinal)
            || !string.Equals(_renderedTopologyFingerprint, topologyFingerprint, StringComparison.Ordinal);
        var interopModel = new
        {
            model.Width,
            model.Height,
            model.Grid,
            Items = model.Items.Select(item => new
            {
                item.Id,
                Layer = MapRenderModelFactory.ToLayerKey(item.Layer),
                item.Kind,
                item.Label,
                item.Glyph,
                item.GridReference,
                item.PixelX,
                item.PixelY,
                item.WorldX,
                item.WorldY,
                item.IsOnline,
                item.IsAlive
            }),
            Rasters = includeExternalMapData ? model.Rasters.Select(raster => new
            {
                raster.Id,
                Layer = MapRenderModelFactory.ToLayerKey(raster.Layer),
                raster.Width,
                raster.Height,
                Rgba = Convert.ToBase64String(raster.Rgba),
                raster.PixelLeft,
                raster.PixelTop,
                raster.PixelRight,
                raster.PixelBottom
            }).ToArray() : null,
            Polylines = includeExternalMapData ? model.Polylines.Select(polyline => new
            {
                polyline.Id,
                Layer = MapRenderModelFactory.ToLayerKey(polyline.Layer),
                polyline.Label,
                polyline.Width,
                polyline.Points
            }).ToArray() : null,
            Polygons = includeExternalMapData ? model.Polygons.Select(polygon => new
            {
                polygon.Id,
                Layer = MapRenderModelFactory.ToLayerKey(polygon.Layer),
                polygon.Label,
                polygon.Points
            }).ToArray() : null,
            HeatSpots = model.HeatSpots.Select(spot => new
            {
                spot.Id,
                Layer = MapRenderModelFactory.ToLayerKey(spot.Layer),
                spot.Label,
                spot.GridReference,
                spot.Count,
                spot.PixelX,
                spot.PixelY,
                spot.LatestAtUtc
            }),
            model.LayerVisibility
        };

        await JavaScript.InvokeVoidAsync(
            "rustPlusMap.render",
            ElementId,
            imageSource,
            interopModel);
        _interopCreated = true;
        _renderedImageSource = imageSource;
        _renderedTopologyFingerprint = topologyFingerprint;
        _renderedMap = State.Map;
        _renderedTeam = State.Team;
        _renderedMarkers = State.Markers;
        _renderedEvents = State.Events;
        _renderedTopology = State.Topology;
        _renderedPersonalPins = State.PersonalPins;
        _renderedMapSize = State.Server?.MapSize;
        _renderedLayerVisibility = layerVisibility;
        await FocusRequestedItemAsync();
    }

    private async Task FocusRequestedItemAsync()
    {
        if (!_interopCreated
            || FocusRequest is not { } request
            || request.Sequence == _handledFocusSequence)
        {
            return;
        }

        if (request.ItemId.StartsWith("pixel:", StringComparison.Ordinal)
            && TryParsePixelTarget(request.ItemId, out var pixelX, out var pixelY))
        {
            await JavaScript.InvokeVoidAsync("rustPlusMap.focusPixel", ElementId, pixelX, pixelY);
        }
        else
        {
            await JavaScript.InvokeVoidAsync("rustPlusMap.focusItem", ElementId, request.ItemId);
        }

        _handledFocusSequence = request.Sequence;
    }

    /// <summary>Parses the "pixel:x,y" convention used by grid-reference search — see MapPage.razor.</summary>
    private static bool TryParsePixelTarget(string itemId, out double pixelX, out double pixelY)
    {
        pixelX = 0;
        pixelY = 0;
        var parts = itemId["pixel:".Length..].Split(',');
        return parts.Length == 2
            && double.TryParse(parts[0], System.Globalization.CultureInfo.InvariantCulture, out pixelX)
            && double.TryParse(parts[1], System.Globalization.CultureInfo.InvariantCulture, out pixelY);
    }

    private static bool LayerVisibilityEquals(
        IReadOnlyDictionary<string, bool>? previous,
        IReadOnlyDictionary<string, bool> current) =>
        previous is not null
        && previous.Count == current.Count
        && current.All(entry => previous.TryGetValue(entry.Key, out var value) && value == entry.Value);

    private string GetImageSource()
    {
        if (State.DataSource == MapDashboardDataSource.Fake)
        {
            return "assets/fake-rust-map.svg";
        }

        var image = State.Map?.JpegImage
            ?? throw new InvalidOperationException("The ready map state has no image.");
        if (!ReferenceEquals(image, _encodedImage))
        {
            _encodedImage = image;
            _imageSource = $"data:image/jpeg;base64,{Convert.ToBase64String(image)}";
        }

        return _imageSource!;
    }

    public async ValueTask DisposeAsync()
    {
        if (!_interopCreated)
        {
            return;
        }

        try
        {
            await JavaScript.InvokeVoidAsync("rustPlusMap.destroy", ElementId);
        }
        catch (JSDisconnectedException)
        {
            // The WebView is already gone; there is no JavaScript map left to release.
        }
    }
}
