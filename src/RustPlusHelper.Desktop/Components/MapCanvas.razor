@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<div id="@ElementId" class="rust-map" aria-label="Interactive Rust server map">
    @if (State.ConnectionState != DashboardConnectionState.Ready)
    {
        <div class="map-placeholder">Waiting for map data…</div>
    }
</div>

@code {
    private readonly string _elementId = $"rust-map-{Guid.NewGuid():N}";
    private bool _interopCreated;
    private byte[]? _encodedImage;
    private string? _imageSource;
    private string? _renderedImageSource;
    private string? _renderedTopologyFingerprint;

    [Parameter, EditorRequired]
    public MapDashboardState State { get; set; } = MapDashboardState.NotStarted;

    private string ElementId => _elementId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var model = MapRenderModelFactory.Create(State);
        if (model is null)
        {
            return;
        }

        var imageSource = GetImageSource();
        var topologyFingerprint = State.Topology?.Data.Sha256;
        var includeExternalMapData = !_interopCreated
            || !string.Equals(_renderedImageSource, imageSource, StringComparison.Ordinal)
            || !string.Equals(_renderedTopologyFingerprint, topologyFingerprint, StringComparison.Ordinal);
        var interopModel = new
        {
            model.Width,
            model.Height,
            model.Grid,
            Items = model.Items.Select(item => new
            {
                item.Id,
                Layer = MapRenderModelFactory.ToLayerKey(item.Layer),
                item.Kind,
                item.Label,
                item.Glyph,
                item.GridReference,
                item.PixelX,
                item.PixelY,
                item.WorldX,
                item.WorldY,
                item.IsOnline,
                item.IsAlive
            }),
            Rasters = includeExternalMapData ? model.Rasters.Select(raster => new
            {
                raster.Id,
                Layer = MapRenderModelFactory.ToLayerKey(raster.Layer),
                raster.Width,
                raster.Height,
                Rgba = Convert.ToBase64String(raster.Rgba),
                raster.PixelLeft,
                raster.PixelTop,
                raster.PixelRight,
                raster.PixelBottom
            }).ToArray() : null,
            Polylines = includeExternalMapData ? model.Polylines.Select(polyline => new
            {
                polyline.Id,
                Layer = MapRenderModelFactory.ToLayerKey(polyline.Layer),
                polyline.Label,
                polyline.Width,
                polyline.Points
            }).ToArray() : null,
            model.LayerVisibility
        };

        await JavaScript.InvokeVoidAsync(
            "rustPlusMap.render",
            ElementId,
            imageSource,
            interopModel);
        _interopCreated = true;
        _renderedImageSource = imageSource;
        _renderedTopologyFingerprint = topologyFingerprint;
    }

    private string GetImageSource()
    {
        if (State.DataSource == MapDashboardDataSource.Fake)
        {
            return "assets/fake-rust-map.svg";
        }

        var image = State.Map?.JpegImage
            ?? throw new InvalidOperationException("The ready map state has no image.");
        if (!ReferenceEquals(image, _encodedImage))
        {
            _encodedImage = image;
            _imageSource = $"data:image/jpeg;base64,{Convert.ToBase64String(image)}";
        }

        return _imageSource!;
    }

    public async ValueTask DisposeAsync()
    {
        if (!_interopCreated)
        {
            return;
        }

        try
        {
            await JavaScript.InvokeVoidAsync("rustPlusMap.destroy", ElementId);
        }
        catch (JSDisconnectedException)
        {
            // The WebView is already gone; there is no JavaScript map left to release.
        }
    }
}
