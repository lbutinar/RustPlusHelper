<section class="content-page">
    <div class="page-heading">
        <div>
            <span class="eyebrow">LIVE SNAPSHOT STATUS</span>
            <h1>Events</h1>
            <p>Direct Rust+ records are live; semantic events will be derived from future polling comparisons.</p>
        </div>
    </div>

    <div class="surface-card event-page-card">
        <div class="timeline-row">
            <span class="timeline-time">NOW</span>
            <span class="event-source direct">TRANSPORT</span>
            <div><strong>@State.ConnectionLabel</strong><p>@(State.LiveDataStatus ?? "No live refresh has completed.")</p></div>
        </div>
        <div class="timeline-row">
            <span class="timeline-time">NOW</span>
            <span class="event-source direct">SNAPSHOT</span>
            <div><strong>@(State.Team?.Members.Count ?? 0) team records and @(State.Markers?.Markers.Count ?? 0) markers received</strong><p>Direct Rust+ snapshot data, not inferred events.</p></div>
        </div>
        <div class="timeline-row future">
            <span class="timeline-time">NEXT</span>
            <span class="event-source derived">DERIVED</span>
            <div><strong>Death, respawn, online, and marker lifecycle</strong><p>These will be produced by comparing snapshots, not invented broadcasts.</p></div>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public MapDashboardState State { get; set; } = MapDashboardState.NotStarted;
}
