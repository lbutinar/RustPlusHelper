@inject RustPlusHelper.Desktop.Services.IEventExportFilePicker ExportFilePicker

<section class="content-page">
    <div class="page-heading">
        <div>
            <span class="eyebrow">LIVE SNAPSHOT STATUS</span>
            <h1>Events</h1>
            <p>Transport changes and team/marker transitions are derived by the centralized background monitor.</p>
        </div>
        <button type="button"
                class="ghost-button"
                data-testid="export-events"
                disabled="@_isExporting"
                @onclick="ExportAsync">
            @(_isExporting ? "Exporting…" : "Export as CSV")
        </button>
    </div>
    @if (_exportMessage is not null)
    {
        <p class="events-export-message" data-testid="export-events-result">@_exportMessage</p>
    }

    <div class="surface-card event-page-card">
        <div class="timeline-row">
            <span class="timeline-time">NOW</span>
            <span class="event-source direct">TRANSPORT</span>
            <div><strong>@State.ConnectionLabel</strong><p>@(State.LiveDataStatus ?? "No live refresh has completed.")</p></div>
        </div>
        @if (State.Events.Count == 0)
        {
            <div class="timeline-row future">
                <span class="timeline-time">WAIT</span>
                <span class="event-source derived">SNAPSHOT DIFF</span>
                <div><strong>No transitions detected yet</strong><p>The initial snapshot establishes a baseline and does not manufacture events.</p></div>
            </div>
        }
        @foreach (var item in State.Events)
        {
            <div class="timeline-row">
                <span class="timeline-time">@item.OccurredAtUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                <span class="event-source @(item.Source == CompanionEventSource.Transport ? "direct" : "derived")">
                    @(item.Source == CompanionEventSource.Transport ? "TRANSPORT" : "SNAPSHOT DIFF")
                </span>
                <div><strong>@item.Title</strong><p>@EventDescription(item.Kind)</p></div>
            </div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public MapDashboardState State { get; set; } = MapDashboardState.NotStarted;

    private bool _isExporting;
    private string? _exportMessage;

    private async Task ExportAsync()
    {
        _isExporting = true;
        _exportMessage = null;
        try
        {
            var fileName = $"rustplushelper-events-{DateTimeOffset.UtcNow:yyyyMMdd-HHmmss}.csv";
            var path = await ExportFilePicker.PickSaveLocationAsync(fileName);
            if (path is null)
            {
                return;
            }

            await using (var stream = System.IO.File.Create(path))
            {
                RustPlusHelper.Application.RustPlus.CompanionEventCsvExporter.Write(State.Events, stream);
            }

            _exportMessage = $"Saved to {path}";
        }
        catch (Exception ex)
        {
            _exportMessage = $"Export failed: {ex.Message}";
        }
        finally
        {
            _isExporting = false;
        }
    }

    private static string EventDescription(CompanionEventKind kind) => kind switch
    {
        CompanionEventKind.ConnectionEstablished => "Persistent Rust+ monitoring started.",
        CompanionEventKind.ConnectionLost => "The monitor will reconnect with bounded backoff.",
        CompanionEventKind.ConnectionRestored => "Authenticated polling resumed.",
        CompanionEventKind.TeamMemberConnected or CompanionEventKind.TeamMemberDisconnected =>
            "Derived from consecutive team online-state snapshots.",
        CompanionEventKind.TeamMemberDied or CompanionEventKind.TeamMemberRespawned =>
            "Derived from consecutive team alive-state snapshots.",
        CompanionEventKind.TeamMemberChangedGrid =>
            "Derived from consecutive online, alive team positions; limited to one event per member per minute.",
        CompanionEventKind.MarkerAppeared or CompanionEventKind.MarkerDisappeared =>
            "Derived from consecutive map-marker snapshots.",
        CompanionEventKind.VendingPriceChanged or CompanionEventKind.VendingStockChanged
            or CompanionEventKind.VendingOfferAdded or CompanionEventKind.VendingOfferRemoved =>
            "Derived from comparing consecutive vending machine sell orders.",
        CompanionEventKind.AlarmTriggered =>
            "Pushed directly by a paired Smart Alarm, independent of polling.",
        _ => "Derived from Rust+ state."
    };
}
