@implements IDisposable
@inject MapDashboardService Dashboard
@inject RustPlusHelper.Desktop.Services.IMapFilePicker MapFilePicker
@using RustPlusHelper.Application.Vending

<div class="app-shell">
    <header class="topbar">
        <div class="brand-block">
            <div class="brand-mark">
                <img src="assets/rustplus-app-icon.png" alt="" />
            </div>
            <div>
                <div class="brand-name">RustPlusHelper</div>
                <div class="brand-subtitle">UNOFFICIAL PERSONAL COMPANION · LIVE MAP</div>
            </div>
        </div>

        <button class="server-selector" type="button" aria-label="Open saved servers" @onclick="() => SelectSection(AppSection.Servers)">
            <span class="server-dot"></span>
            <span>
                <strong>@(State.Server?.Name ?? "No map loaded")</strong>
                <small>@(State.Server?.MapName ?? DataSourceDetail)</small>
            </span>
            <span class="selector-chevron">⌄</span>
        </button>

        <div class="connection-state @ConnectionCssClass">
            <span class="pulse-dot"></span>
            <span>@State.ConnectionLabel</span>
            <span class="demo-badge">@DataSourceBadge</span>
        </div>
    </header>

    <aside class="sidebar" aria-label="Primary navigation">
        <nav>
            @foreach (var item in Navigation)
            {
                <button type="button"
                        class="nav-item @(ActiveSection == item.Section ? "active" : null)"
                        title="@item.Label"
                        @onclick="() => SelectSection(item.Section)">
                    <span class="nav-icon material-icons" aria-hidden="true">@item.Icon</span>
                    <span>@item.Label</span>
                </button>
            }
        </nav>

        <div class="sidebar-footer">
            <div class="wipe-label">MAP WIPE</div>
            <strong>@FormatWipeTime()</strong>
            <span>@DataSourceDetail</span>
        </div>
    </aside>

    <main class="main-content">
        @if (State.ConnectionState == DashboardConnectionState.Loading)
        {
            <section class="loading-state">
                <div class="loader-ring"></div>
                <h1>Loading Rust+ map</h1>
                <p>Requesting verified server and map snapshots.</p>
            </section>
        }
        else if (State.ConnectionState == DashboardConnectionState.Failed)
        {
            <section class="error-state">
                <span class="error-code">MAP LOAD FAILED</span>
                <h1>The selected Rust+ map could not be loaded.</h1>
                <p>@State.ErrorMessage</p>
                <button type="button" class="primary-button" @onclick="() => SelectSection(AppSection.Servers)">Open servers</button>
            </section>
        }
        else
        {
            @switch (ActiveSection)
            {
                case AppSection.Map:
                    <MapPage State="State"
                             FocusRequest="_mapFocusRequest"
                             OnLayerChanged="HandleLayerChanged"
                             OnRefreshRequested="RefreshMap"
                             OnLiveDataRefreshRequested="RefreshLiveData"
                             OnTopologyImportRequested="ImportTopology" />
                    break;
                case AppSection.Team:
                    <TeamPage State="State" />
                    break;
                case AppSection.Events:
                    <EventsPage State="State" />
                    break;
                case AppSection.Vending:
                    <VendingPage State="State" OnLocate="LocateVending" />
                    break;
                case AppSection.Devices:
                    <DevicesPage State="State" />
                    break;
                case AppSection.Servers:
                    <ServersPage State="State" OnOpenMap="OpenServerMap" />
                    break;
                case AppSection.Settings:
                    <SettingsPage />
                    break;
            }
        }
    </main>
</div>

@code {
    private static readonly NavItem[] Navigation =
    [
        new(AppSection.Map, "Map", "map"),
        new(AppSection.Team, "Team", "chat_bubble"),
        new(AppSection.Events, "Events", "notifications_active"),
        new(AppSection.Vending, "Vending", "storefront"),
        new(AppSection.Devices, "Devices & Cameras", "lightbulb"),
        new(AppSection.Servers, "Servers", "dns"),
        new(AppSection.Settings, "Settings", "settings")
    ];

    private MapDashboardState State => Dashboard.Current;

    private AppSection ActiveSection { get; set; } = AppSection.Map;
    private MapFocusRequest? _mapFocusRequest;
    private long _mapFocusSequence;

    private string ConnectionCssClass => State.IsLiveDataRefreshing
        ? "loading"
        : State.ConnectionState switch
    {
        DashboardConnectionState.Ready => "ready",
        DashboardConnectionState.Failed => "failed",
        _ => "loading"
    };

    private string DataSourceBadge => State.LiveDataRetrievedAtUtc is not null
        && State.DataSource != MapDashboardDataSource.Fake
        ? "LIVE DATA"
        : State.DataSource switch
    {
        MapDashboardDataSource.Live => "LIVE RUST+",
        MapDashboardDataSource.Cache => "CACHED",
        MapDashboardDataSource.Fake => "FAKE DATA",
        _ => "NO DATA"
    };

    private string DataSourceDetail => State.DataSource switch
    {
        MapDashboardDataSource.Live => "Rust+ live snapshot",
        MapDashboardDataSource.Cache => "Local cached snapshot",
        MapDashboardDataSource.Fake => "Local fake session",
        _ => "Choose a saved server"
    };

    protected override async Task OnInitializedAsync()
    {
        Dashboard.StateChanged += HandleStateChanged;
        await Dashboard.InitializeAsync();
    }

    public void Dispose()
    {
        Dashboard.StateChanged -= HandleStateChanged;
    }

    private void SelectSection(AppSection section) => ActiveSection = section;

    private void HandleLayerChanged(LayerVisibilityChange change) =>
        Dashboard.SetLayerVisibility(change.Kind, change.IsVisible);

    private async Task RefreshMap() => await Dashboard.RefreshSelectedServerAsync();

    private async Task RefreshLiveData() => await Dashboard.RefreshLiveDataAsync();

    private async Task ImportTopology()
    {
        var filePath = await MapFilePicker.PickRustMapAsync();
        if (!string.IsNullOrWhiteSpace(filePath))
        {
            await Dashboard.ImportTopologyAsync(filePath);
        }
    }

    private async Task OpenServerMap(Guid serverId)
    {
        ActiveSection = AppSection.Map;
        await Dashboard.LoadServerAsync(serverId);
    }

    private void LocateVending(VendingMachineListing listing)
    {
        if (listing.MarkerId is not { } markerId)
        {
            return;
        }

        Dashboard.SetLayerVisibility(MapLayerKind.VendingMachines, true);
        _mapFocusRequest = new MapFocusRequest(
            $"marker:{markerId.ToString(System.Globalization.CultureInfo.InvariantCulture)}",
            ++_mapFocusSequence);
        ActiveSection = AppSection.Map;
    }

    private void HandleStateChanged(object? sender, EventArgs args) =>
        _ = InvokeAsync(StateHasChanged);

    private string FormatWipeTime() => State.Server?.WipeTimeUtc?.ToString("dd MMM yyyy") ?? "Not loaded";

    private sealed record NavItem(AppSection Section, string Label, string Icon);

    private enum AppSection
    {
        Map,
        Team,
        Events,
        Vending,
        Devices,
        Servers,
        Settings
    }
}
